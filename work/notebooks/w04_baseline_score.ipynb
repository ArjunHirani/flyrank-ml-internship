      ],
      "source": [
        "%pip -q install duckdb huggingface_hub\n",
        "\n",
        "import os, getpass\n",
        "HF_TOKEN = os.environ.get('HF_TOKEN') or getpass.getpass('Paste your Hugging Face READ token (hf_...): ')\n",
        "\n",
        "import duckdb, pandas as pd, numpy as np\n",
        "con = duckdb.connect()\n",
        "con.execute(\"CREATE OR REPLACE SECRET hf (TYPE huggingface, TOKEN ?)\", [HF_TOKEN])\n",
        "\n",
        "REL = 'hf://datasets/FlyRank/internship-warehouse'\n",
        "TABLES = {\n",
        "    'dim_clients':       f\"read_parquet('{REL}/dim_clients.parquet')\",\n",
        "    'dim_content':       f\"read_parquet('{REL}/dim_content.parquet')\",\n",
        "    'fact_daily':        f\"read_parquet('{REL}/fact_content_daily_performance/**/*.parquet')\",\n",
        "}\n",
        "\n",
        "data = con.sql(f\"\"\"\n",
        "    WITH march AS (\n",
        "        SELECT client_hash_id, content_hash_id,\n",
        "               SUM(CASE WHEN gsc_data_available THEN gsc_impressions ELSE 0 END) AS impressions_march,\n",
        "               SUM(CASE WHEN gsc_data_available THEN gsc_clicks ELSE 0 END) AS clicks_march,\n",
        "               AVG(CASE WHEN gsc_data_available THEN gsc_avg_position END) AS avg_position_march,\n",
        "               COUNT(DISTINCT CASE WHEN gsc_data_available THEN report_date END) AS active_days_march\n",
        "        FROM {TABLES['fact_daily']}\n",
        "        WHERE month = '2026-03'\n",
        "        GROUP BY 1, 2\n",
        "        HAVING impressions_march >= 100\n",
        "    ),\n",
        "    april AS (\n",
        "        SELECT client_hash_id, content_hash_id,\n",
        "               SUM(CASE WHEN gsc_data_available THEN gsc_clicks ELSE 0 END) AS clicks_april\n",
        "        FROM {TABLES['fact_daily']}\n",
        "        WHERE month = '2026-04'\n",
        "        GROUP BY 1, 2\n",
        "    )\n",
        "    SELECT m.*, a.clicks_april\n",
        "    FROM march m\n",
        "    JOIN april a USING (client_hash_id, content_hash_id)\n",
        "\"\"\").df()\n",
        "\n",
        "content_meta = con.sql(f\"SELECT client_hash_id, content_hash_id, content_created_date FROM {TABLES['dim_content']}\").df()\n",
        "data = data.merge(content_meta, on=['client_hash_id', 'content_hash_id'], how='left')\n",
        "data['content_age_days_march'] = (pd.Timestamp('2026-03-31') - pd.to_datetime(data['content_created_date'])).dt.days\n",
        "data['ctr_march'] = data['clicks_march'] / data['impressions_march']\n",
        "data['is_declining_april'] = (data['clicks_april'] < data['clicks_march']).astype(int)\n",
        "\n",
        "print(f\"Rows (active March pages with an April outcome): {len(data):,}\")\n",
        "print(f\"Base rate (share declining): {data['is_declining_april'].mean():.3f}\")"
      ],
      "id": "YSzJgY1miLOP"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "vCRynAC6iLOQ"
      },
      "source": [
        "**Signal 2 — CTR-vs-position gap → linked to the CTR-fix logic.** Build an empirical \"expected\n",
        "CTR\" per position tier (the average CTR other pages get at that rank), then bucket pages by\n",
        "whether they're meeting, above, or below that expectation, and compare April decline rates."
      ],
      "id": "vCRynAC6iLOQ"
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "hAkKTNH5iLOR",
        "outputId": "c91bc3b5-c50f-4f19-dd02-15f5f027759e"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Signal 2: CTR-vs-position-expected gap vs April decline rate\n",
            "ctr_vs_expected     n  decline_rate\n",
            " Below_expected 68622      0.277841\n",
            " Meets_or_above 32819      0.662147\n",
            "\n",
            "Overall base rate: 0.402\n"
          ]
        }
      ],
      "source": [
        "pos_valid = data.dropna(subset=['avg_position_march', 'ctr_march']).copy()\n",
        "pos_valid['position_tier'] = pd.cut(pos_valid['avg_position_march'],\n",
        "                                     bins=[0, 3, 10, 20, 50, np.inf],\n",
        "                                     labels=['top3', '4-10', '11-20', '21-50', '50+'])\n",
        "\n",
        "expected_ctr = pos_valid.groupby('position_tier', observed=True)['ctr_march'].transform('mean')\n",
        "pos_valid['ctr_gap'] = pos_valid['ctr_march'] - expected_ctr\n",
        "pos_valid['ctr_vs_expected'] = np.where(pos_valid['ctr_gap'] < 0, 'Below_expected', 'Meets_or_above')\n",
        "\n",
        "ctr_table = pos_valid.groupby('ctr_vs_expected', observed=True).agg(\n",
        "    n=('is_declining_april', 'size'),\n",
        "    decline_rate=('is_declining_april', 'mean')\n",
        ").reset_index()\n",
        "print(\"Signal 2: CTR-vs-position-expected gap vs April decline rate\")\n",
        "print(ctr_table.to_string(index=False))\n",
        "print(f\"\\nOverall base rate: {pos_valid['is_declining_april'].mean():.3f}\")"
      ],
      "id": "hAkKTNH5iLOR"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "qFrnNd6SiLOR"
      },
      "source": [
        "**Verdicts** *(filled in after running the cells above — see the printed decline rates)*:\n",
        "\n",
        "- **Signal 1 (staleness):** *[VERDICT]* — state CONFIRMED / OPPOSITE / MIXED / FALSE based on\n",
        "  whether `Q4_oldest` shows a clearly higher decline rate than `Q1_newest`, and whether the\n",
        "  pattern is monotonic across quartiles.\n",
        "- **Signal 2 (CTR-vs-position gap):** *[VERDICT]* — state the verdict based on whether\n",
        "  `Below_expected` shows a meaningfully higher decline rate than `Meets_or_above`.\n",
        "\n",
        "**Reason codes this rule can output:** exactly one — `STALE_AND_CTR_UNDERPERFORMING` — since\n",
        "this is one rule combining exactly the two signals checked above, not a multi-branch system.\n",
        "\n",
        "**No future-window or label-derived inputs:** the rule below uses only `content_age_days_march`\n",
        "and `ctr_gap` (both fully knowable by end of March). `is_declining_april` and `clicks_april` are\n",
        "used ONLY to check the signals above and to evaluate the rule afterward — never as rule inputs."
      ],
      "id": "qFrnNd6SiLOR"
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 2. Build the ranked queue (writes the CSV)\n",
        "\n",
        "Score = average of two percentile ranks (older = higher, bigger CTR deficit = higher) — simple,\n",
        "readable, no fitted weights, per the baseline skill. Action label ties directly back to the\n",
        "Week-1 reviewer-capacity argument (~50 pages/week): top 50 = priority, next 150 = monitor, rest\n",
        "= no action this cycle."
      ],
      "metadata": {
        "id": "MCe44Jo9jzhY"
      },
      "id": "MCe44Jo9jzhY"
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "w6vtz6zkiLOS",
        "outputId": "4eaa724b-f234-49e1-c4d1-720a180cc44e"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Base rate: 0.402\n",
            "Baseline rule Precision@20: 0.000\n",
            "Baseline rule Precision@50: 0.000\n",
            "\n",
            "Action label counts:\n",
            "action_label\n",
            "NO_ACTION_THIS_CYCLE    101241\n",
            "MONITOR_CLOSELY            150\n",
            "PRIORITIZE_REFRESH          50\n",
            "Name: count, dtype: int64\n",
            "\n",
            "Wrote work/outputs/baseline_action_score.csv\n",
            "Wrote work/outputs/baseline_metrics.json\n"
          ]
        }
      ],
      "source": [
        "queue = data.dropna(subset=['content_age_days_march', 'avg_position_march', 'ctr_march']).copy()\n",
        "\n",
        "# recompute ctr_gap on the full queue population (same logic as Signal 2 above)\n",
        "queue['position_tier'] = pd.cut(queue['avg_position_march'],\n",
        "                                 bins=[0, 3, 10, 20, 50, np.inf],\n",
        "                                 labels=['top3', '4-10', '11-20', '21-50', '50+'])\n",
        "expected_ctr_full = queue.groupby('position_tier', observed=True)['ctr_march'].transform('mean')\n",
        "queue['ctr_gap'] = queue['ctr_march'] - expected_ctr_full\n",
        "\n",
        "staleness_rank = queue['content_age_days_march'].rank(pct=True)\n",
        "ctr_deficit_rank = (-queue['ctr_gap']).rank(pct=True)\n",
        "queue['rule_score'] = 0.5 * staleness_rank + 0.5 * ctr_deficit_rank\n",
        "\n",
        "queue = queue.sort_values('rule_score', ascending=False).reset_index(drop=True)\n",
        "queue['rank'] = queue.index + 1\n",
        "\n",
        "queue['reason_code'] = 'STALE_AND_CTR_UNDERPERFORMING'\n",
        "queue['action_label'] = np.select(\n",
        "    [queue['rank'] <= 50, queue['rank'] <= 200],\n",
        "    ['PRIORITIZE_REFRESH', 'MONITOR_CLOSELY'],\n",
        "    default='NO_ACTION_THIS_CYCLE'\n",
        ")\n",
        "\n",
        "def precision_at_k(scores, labels, k):\n",
        "    order = np.argsort(-np.asarray(scores))\n",
        "    return np.asarray(labels)[order[:k]].mean()\n",
        "\n",
        "base_rate = queue['is_declining_april'].mean()\n",
        "p20 = precision_at_k(queue['rule_score'], queue['is_declining_april'], 20)\n",
        "p50 = precision_at_k(queue['rule_score'], queue['is_declining_april'], 50)\n",
        "print(f\"Base rate: {base_rate:.3f}\")\n",
        "print(f\"Baseline rule Precision@20: {p20:.3f}\")\n",
        "print(f\"Baseline rule Precision@50: {p50:.3f}\")\n",
        "print(f\"\\nAction label counts:\\n{queue['action_label'].value_counts()}\")\n",
        "\n",
        "import json\n",
        "os.makedirs('work/outputs', exist_ok=True)\n",
        "\n",
        "output_cols = ['client_hash_id', 'content_hash_id', 'rank', 'rule_score', 'reason_code',\n",
        "               'action_label', 'content_age_days_march', 'avg_position_march', 'ctr_march',\n",
        "               'ctr_gap', 'is_declining_april']\n",
        "queue[output_cols].to_csv('work/outputs/baseline_action_score.csv', index=False)\n",
        "print(\"\\nWrote work/outputs/baseline_action_score.csv\")\n",
        "\n",
        "metrics = {\n",
        "    'month_feature_window': '2026-03', 'month_label_window': '2026-04',\n",
        "    'n_rows': int(len(queue)), 'base_rate': round(float(base_rate), 4),\n",
        "    'precision_at_20': round(float(p20), 4), 'precision_at_50': round(float(p50), 4),\n",
        "    'reason_code': 'STALE_AND_CTR_UNDERPERFORMING',\n",
        "    'action_thresholds': {'PRIORITIZE_REFRESH': 'rank<=50', 'MONITOR_CLOSELY': 'rank<=200'}\n",
        "}\n",
        "with open('work/outputs/baseline_metrics.json', 'w') as f:\n",
        "    json.dump(metrics, f, indent=2)\n",
        "print(\"Wrote work/outputs/baseline_metrics.json\")"
      ],
      "id": "w6vtz6zkiLOS"
    },
